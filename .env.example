# TigerGraph MCP connection configuration. Copy to .env and supply credentials locally.
TG_HOST=
TG_GRAPHNAME=FraudInvestigationGraph
TG_API_TOKEN=
TG_TGCLOUD=true
TG_SSL_PORT=443
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=

# GraphRAG embedding configuration.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GRAPHRAG_VECTOR_ATTRIBUTE=local_embedding
GRAPHRAG_VERTEX_TYPE=KnowledgeChunk

# Optional grounded synthesis. GPT-4o Mini is the low-cost default for this demo.
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini
# With LLM_PROVIDER=openai, the LLM chooses the agent's next graph tool (set off to use the rule planner).
LLM_PLANNER=on

# Local reference API configuration.
CASE_PACK_PATH=/absolute/path/to/case_pack.csv
# Optional: transactions.csv used to build the case timeline and relationship map.
TRANSACTIONS_PATH=
# Optional: closed_cases_history.csv used for linked and similar prior cases.
CLOSED_CASES_PATH=
# Optional: identity.csv, used to derive device profiles in CSV mode.
IDENTITY_PATH=
# csv (default) answers the agent's tools from the files above; tigergraph uses installed GSQL queries over MCP.
DATA_SOURCE=csv
# Optional: folder of policy, pattern and regulation documents (.md/.txt) the agent cites.
POLICY_DOCS_PATH=
# Optional: where the agent keeps memory of its own finished investigations.
CASE_MEMORY_PATH=
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
APP_API_KEY=
APP_APPROVER_ROLE=fraud_approver
# Optional per-process protection for the local/reference API. 0 disables it.
APP_RATE_LIMIT_PER_MINUTE=0
