# TigerGraph MCP connection configuration. Copy to .env and supply credentials locally.
TG_HOST=
TG_GRAPHNAME=FraudInvestigationGraph
TG_API_TOKEN=
TG_TGCLOUD=true
TG_SSL_PORT=443
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=

# GraphRAG embedding configuration.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GRAPHRAG_VECTOR_ATTRIBUTE=embedding

# Local reference API configuration.
CASE_PACK_PATH=/absolute/path/to/case_pack.csv
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
APP_API_KEY=
APP_APPROVER_ROLE=fraud_approver
