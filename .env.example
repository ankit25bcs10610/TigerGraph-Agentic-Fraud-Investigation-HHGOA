# TigerGraph MCP connection configuration. Copy to .env and supply credentials locally.
TG_HOST=
TG_GRAPHNAME=FraudInvestigationGraph
TG_API_TOKEN=
TG_TGCLOUD=true
TG_SSL_PORT=443

# Optional alternative to TG_API_TOKEN. The MCP client prefers TG_API_TOKEN when set.
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=

# GraphRAG embedding configuration (select a provider/model; never commit keys).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GRAPHRAG_VECTOR_ATTRIBUTE=embedding
