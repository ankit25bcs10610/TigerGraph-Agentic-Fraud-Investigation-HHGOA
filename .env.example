# TigerGraph MCP connection configuration. Copy to .env and supply credentials locally.
TG_HOST=
TG_GRAPHNAME=FraudInvestigationGraph
TG_API_TOKEN=
TG_TGCLOUD=true
TG_SSL_PORT=443
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=

# GraphRAG embedding configuration.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GRAPHRAG_VECTOR_ATTRIBUTE=embedding

# Optional grounded synthesis. GPT-4o Mini is the low-cost default for this demo.
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini

# Local reference API configuration.
CASE_PACK_PATH=/absolute/path/to/case_pack.csv
# Optional: transactions.csv used to build the case timeline and relationship map.
TRANSACTIONS_PATH=
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
APP_API_KEY=
APP_APPROVER_ROLE=fraud_approver
# Optional per-process protection for the local/reference API. 0 disables it.
APP_RATE_LIMIT_PER_MINUTE=0
