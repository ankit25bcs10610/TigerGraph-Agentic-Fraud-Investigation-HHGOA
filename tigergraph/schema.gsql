CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_profile_id STRING,
    device_info STRING,
    device_type STRING,
    os STRING,
    browser STRING,
    screen STRING,
    device_status STRING,
    proxy_type STRING,
    match_status STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX EmailDomain (
    PRIMARY_ID email_domain STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX BillingRegion (
    PRIMARY_ID billing_region_id STRING,
    addr1 STRING,
    addr2 STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    first_fraud_txn_id STRING,
    n_txns UINT,
    exposure_usd FLOAT,
    report_filed STRING,
    connected_card_ids STRING,
    actions_taken STRING,
    analyst_notes STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX InvestigationCase (
    PRIMARY_ID investigation_case_id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    status STRING,
    verdict STRING,
    pattern STRING,
    fraud_probability FLOAT,
    exposure_usd FLOAT,
    trigger_type STRING,
    trigger_text STRING,
    evidence_summary STRING,
    evidence_requests STRING,
    recommended_actions STRING,
    approval_route STRING,
    sar_narrative STRING
) WITH primary_id_as_attribute="true";

CREATE DIRECTED EDGE OWNS (
    FROM Customer, TO Card
);

CREATE DIRECTED EDGE MADE (
    FROM Card, TO Transaction
);

CREATE DIRECTED EDGE FROM_DEVICE (
    FROM Transaction, TO DeviceProfile
);

CREATE DIRECTED EDGE PURCHASER_EMAIL (
    FROM Transaction, TO EmailDomain,
    email_role STRING
);

CREATE DIRECTED EDGE BILLED_IN (
    FROM Transaction, TO BillingRegion
);

CREATE DIRECTED EDGE NEXT (
    FROM Transaction, TO Transaction,
    ts DATETIME
);

CREATE DIRECTED EDGE INVOLVES (
    FROM ClosedCase, TO Transaction,
    relation STRING
);

CREATE DIRECTED EDGE ON_CARD (
    FROM ClosedCase, TO Card
);

CREATE DIRECTED EDGE CONNECTED_TO (
    FROM ClosedCase, TO Card,
    relation STRING
);

CREATE DIRECTED EDGE FLAGGED_TRANSACTION (
    FROM InvestigationCase, TO Transaction
);

CREATE DIRECTED EDGE FOR_CUSTOMER (
    FROM InvestigationCase, TO Customer
);

CREATE DIRECTED EDGE FOR_CARD (
    FROM InvestigationCase, TO Card
);

CREATE DIRECTED EDGE AFFECTS (
    FROM InvestigationCase, TO Transaction
);

CREATE DIRECTED EDGE CONNECTED_CARD (
    FROM InvestigationCase, TO Card
);

CREATE DIRECTED EDGE CONNECTED_DEVICE (
    FROM InvestigationCase, TO DeviceProfile
);

CREATE DIRECTED EDGE SIMILAR_TO_CLOSED_CASE (
    FROM InvestigationCase, TO ClosedCase,
    similarity_reason STRING
);

// GraphRAG knowledge chunks (policy passages, pattern documents, closed-case narratives).
// The vector attribute is added at indexing time so its dimension matches the embedding model.
CREATE VERTEX KnowledgeChunk (
    PRIMARY_ID chunk_id STRING,
    source_type STRING,
    source_id STRING,
    title STRING,
    text STRING,
    section STRING
) WITH primary_id_as_attribute="true";

CREATE GRAPH FraudInvestigation (*);
