// TigerGraph fraud investigation schema.
// Schema only: loading jobs and queries are intentionally out of scope.
// Empty CSV values should be loaded as NULL/default according to the deployment's
// loading configuration. risk_score is an input signal, not a fraud verdict.

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    customer_id STRING,
    card1 STRING,
    card2 STRING,
    card3 STRING,
    card4 STRING,
    card5 STRING,
    card6 STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Transaction (
    PRIMARY_ID transaction_id STRING,
    transaction_dt UINT,
    transaction_amt FLOAT,
    product_cd STRING,
    customer_id STRING,
    ts DATETIME,
    channel STRING,
    risk_score FLOAT,
    card1 STRING, card2 STRING, card3 STRING, card4 STRING, card5 STRING, card6 STRING,
    addr1 STRING, addr2 STRING, dist1 FLOAT, dist2 FLOAT,
    p_emaildomain STRING, r_emaildomain STRING,
    c1 FLOAT,
    c2 FLOAT,
    c3 FLOAT,
    c4 FLOAT,
    c5 FLOAT,
    c6 FLOAT,
    c7 FLOAT,
    c8 FLOAT,
    c9 FLOAT,
    c10 FLOAT,
    c11 FLOAT,
    c12 FLOAT,
