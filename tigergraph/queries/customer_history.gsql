CREATE QUERY customer_history(STRING customer_id) FOR GRAPH FraudInvestigation SYNTAX v2 {
  customer = SELECT c
             FROM Customer:c
             WHERE c.customer_id == customer_id;

  cards = SELECT c
          FROM customer:cu -(OWNS>:e)- c:Card;

  history = SELECT t
            FROM cards:c -(MADE>:e)- t:Transaction
            ORDER BY t.ts ASC;

  PRINT customer, cards, history;
}
