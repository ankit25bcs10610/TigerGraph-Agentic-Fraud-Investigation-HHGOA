CREATE QUERY email_neighbors(STRING email_domain) FOR GRAPH FraudInvestigation SYNTAX v2 {
  domain = SELECT d
           FROM EmailDomain:d
           WHERE d.email_domain == email_domain;

  transactions = SELECT t
                 FROM domain:d -( <PURCHASER_EMAIL:e)- t:Transaction
                 ORDER BY t.ts ASC;

  cards = SELECT DISTINCT c
          FROM transactions:t -( <MADE:e)- c:Card;

  customers = SELECT DISTINCT customer
              FROM cards:c -( <OWNS:e)- customer:Customer;

  PRINT domain, transactions, cards, customers;
}
