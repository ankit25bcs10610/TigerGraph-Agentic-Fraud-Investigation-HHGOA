CREATE QUERY region_history(STRING card_id) FOR GRAPH FraudInvestigation SYNTAX v2 {
  card = SELECT c
         FROM Card:c
         WHERE c.card_id == card_id;

  transactions = SELECT t
                 FROM card:c -(MADE>:e1)- t:Transaction;

  regions = SELECT DISTINCT r
            FROM transactions:t -(BILLED_IN>:e2)- r:BillingRegion;

  activity = SELECT t
             FROM transactions:t -(BILLED_IN>:e3)- r:BillingRegion
             ORDER BY t.ts ASC;

  PRINT card, regions, activity;
}
