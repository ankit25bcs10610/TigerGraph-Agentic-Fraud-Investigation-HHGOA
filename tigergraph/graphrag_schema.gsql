// GraphRAG schema extension, for graphs created before schema.gsql included KnowledgeChunk.
// New deployments get KnowledgeChunk from schema.gsql and do not need this file.
// Apply once after FraudInvestigation exists.
// The vector attribute is intentionally created through the official MCP tool:
// its dimension must match the configured embedding provider at runtime.
// Before applying, check that KnowledgeChunk does not already exist; do not
// re-run CREATE VERTEX against an existing vertex type.

USE GRAPH FraudInvestigation;

CREATE VERTEX KnowledgeChunk (
    PRIMARY_ID chunk_id STRING,
    source_type STRING,
    source_id STRING,
    title STRING,
    text STRING,
    section STRING
) WITH primary_id_as_attribute="true";
